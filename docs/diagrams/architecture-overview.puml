@startuml architecture-overview
!include _style.puml

title Architecture of the temperature monitoring at RotorWind GmbH

package "Data collection" {
  component "Sensor simulator\nand Kafka producer" as producer <<prototype>>
  component "Edge gateway\n(MQTT or OPC UA)" as gateway <<target only>>
}

package "Message queuing\nApache Kafka" {
  queue "machine-temperature" as tempTopic <<topic>>
  queue "machine-alerts" as alertTopic <<topic>>
}

package "Stream processing" {
  component "Python stream processor\n(rules, state of alerts)" as processor <<prototype>>
}

package "Hot storage\nTimescaleDB" {
  database "readings\n(hypertable)" as readings
  database "alerts" as alerts
  database "machines" as machines
  database "readings_hourly\n(continuous aggregate)" as hourly
}

package "Data access" {
  component "Grafana\n(dashboard, alert rule,\ncontact point)" as grafana <<prototype>>
  component "Webhook receiver\n(notifier)" as notifier <<prototype>>
}

package "Archive" {
  component "Archive writer" as archiver <<target only>>
  database "Object storage\n(columnar files)" as archive <<target only>>
}

package "Existing reporting" {
  component "Data warehouse\n(weekly load, BI)" as dwh <<existing>>
}

actor "Shift operator" as operator

gateway ..> tempTopic : publishes
producer --> tempTopic : publishes readings\nkey: machine_id
tempTopic --> processor : consumer group
processor --> readings : insert, idempotent
processor --> alerts : insert event,\nidempotent
processor --> machines : registers machines\nand thresholds at start
processor --> alertTopic : publishes alerts\nkey: machine_id
readings --> hourly : aggregates
readings --> grafana : SQL
alerts --> grafana : SQL
hourly --> grafana : SQL
machines --> grafana : SQL
grafana --> operator : dashboard
grafana --> notifier : webhook on a\ncritical alert
notifier --> operator : notification
alertTopic ..> archiver : second consumer group
tempTopic ..> archiver : second consumer group
archiver ..> archive : writes once
hourly --> dwh : view for the\nweekly load

note bottom of archive
  Components marked target only, and the dashed arrows
  that lead to them, belong to the target architecture
  and are not built in the prototype.
end note

@enduml
