    {
      "id": 7,
      "type": "timeseries",
      "title": "Hourly history of $machine",
      "description": "Minimum, mean, and maximum per hour of the selected machine, read from the continuous aggregate readings_hourly over the last 24 hours.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bladewatch-timescaledb"
      },
      "timeFrom": "24h",
      "gridPos": {
        "x": 12,
