          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  measured_at AS \"Time\",\n  machine_id AS \"Machine\",\n  status AS \"Status\",\n  severity AS \"Severity\",\n  kind AS \"Kind\",\n  temperature_c AS \"Temperature (°C)\",\n  \"limit\" AS \"Limit\"\nFROM alerts\nWHERE measured_at > now() - interval '24 hours'\nORDER BY measured_at DESC\nLIMIT 50"
