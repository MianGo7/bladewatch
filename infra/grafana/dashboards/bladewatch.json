            "uid": "bladewatch-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  bucket AS time,\n  min_temperature_c AS \"minimum\",\n  mean_temperature_c AS \"mean\",\n  max_temperature_c AS \"maximum\"\nFROM readings_hourly\nWHERE machine_id = '$machine' AND $__timeFilter(bucket)\nORDER BY bucket"
