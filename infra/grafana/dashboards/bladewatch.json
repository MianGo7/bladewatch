{
  "uid": "bladewatch-overview",
  "title": "BladeWatch machine monitoring",
  "description": "Current state, temperature history, and alerts of the twelve machines of RotorWind GmbH.",
  "tags": [
    "bladewatch"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1s",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "5s",
      "10s",
      "30s"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "machine",
        "label": "Machine",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "bladewatch-timescaledb"
        },
        "query": "SELECT machine_id FROM machines ORDER BY machine_id",
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "mould-01",
          "value": "mould-01"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "State of the machines",
      "description": "The latest reading of every machine with its thresholds, the age of that reading in seconds, and the severity of its open alert. The state is also written as text.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bladewatch-timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 15,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bladewatch-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  machine_id AS \"Machine\",\n  COALESCE(open_alert_severity, 'normal') AS \"State\",\n  temperature_c AS \"Temp. (°C)\",\n  warning_c AS \"Warning (°C)\",\n  critical_c AS \"Critical (°C)\",\n  EXTRACT(EPOCH FROM now() - measured_at)::float8 AS \"Age (s)\"\nFROM machine_status\nORDER BY machine_type, machine_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "minWidth": 70
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "normal": {
                        "text": "normal",
                        "color": "#0ca30c",
                        "index": 0
                      },
                      "warning": {
                        "text": "warning",
                        "color": "#fab219",
                        "index": 1
                      },
                      "critical": {
                        "text": "critical",
                        "color": "#d03b3b",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Temp. (°C)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Age (s)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Moulds",
      "description": "Temperature of every mould. The lines mark the warning threshold at 80 and the critical threshold at 95 degrees Celsius.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bladewatch-timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bladewatch-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT r.measured_at AS time, r.machine_id AS metric, r.temperature_c AS value\nFROM readings AS r\nJOIN machines AS m ON m.machine_id = r.machine_id\nWHERE $__timeFilter(r.measured_at) AND m.machine_type = 'mould'\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "fillOpacity": 0,
            "spanNulls": false,
            "axisLabel": "Temperature (°C)",
            "thresholdsStyle": {
              "mode": "line"
            },
            "axisSoftMin": 50.0,
            "axisSoftMax": 100.0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 80.0
              },
              {
                "color": "#d03b3b",
                "value": 95.0
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*-01$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*-02$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#eb6834"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*-03$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1baf7a"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*-04$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#eda100"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
