    {
      "id": 5,
      "type": "table",
      "title": "Open alerts",
      "description": "Alerts without a closing event. The severity is the highest one that the alert has reached.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bladewatch-timescaledb"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 9,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bladewatch-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  machine_id AS \"Machine\",\n  severity AS \"Severity\",\n  kind AS \"Kind\",\n  temperature_c AS \"Temperature (°C)\",\n  \"limit\" AS \"Limit\",\n  measured_at AS \"Last event\"\nFROM open_alerts\nORDER BY measured_at DESC"
